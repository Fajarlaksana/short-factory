# Salin file ini menjadi .env lalu isi nilainya (tanpa tanda kutip).
# File .env sudah ada di .gitignore, jadi tidak akan ikut ter-commit.

# ===== WAJIB (AI + B-roll) =====
# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# https://www.pexels.com/api/
PEXELS_API_KEY=

# ===== OPSIONAL =====
# https://huggingface.co/settings/tokens (fallback AI)
HUGGINGFACE_API_KEY=
# https://pixabay.com/api/docs/ (musik/B-roll tambahan)
PIXABAY_API_KEY=

# ===== UPLOAD YOUTUBE (opsional, hanya jika upload) =====
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ===== UPLOAD DAILYMOTION (opsional) =====
DAILYMOTION_API_KEY=
DAILYMOTION_API_SECRET=
DAILYMOTION_USERNAME=
DAILYMOTION_PASSWORD=

# ===== LOKAL =====
IMAGEMAGICK_BINARY=C:\Program Files\ImageMagick-7.1.2-Q16-HDRI\magick.exe
